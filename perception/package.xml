<?xml version="1.0"?>
<package format="3">
  <name>perception</name>
  <version>0.1.0</version>
  <description>Human perception: YOLOv8 + ByteTrack + lidar range fusion + Kalman filter -> /human_tracks</description>
  <maintainer email="girija.connect13@gmail.com">Girija</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
