<?xml version="1.0"?>
<sdf version="1.8">
  <model name="turtlebot3_waffle">
    <link name="base_link">
      <pose>0 0 0.010 0 0 0</pose>
      <inertial>
        <pose>-0.064 0 0 0 0 0</pose>
        <mass>1.3729096</mass>
        <inertia>
          <ixx>8.7002718e-03</ixx><ixy>-4.7576583e-05</ixy><ixz>1.1160499e-04</ixz>
          <iyy>8.6195418e-03</iyy><iyz>-3.5422299e-06</iyz><izz>1.4612727e-02</izz>
        </inertia>
      </inertial>
      <collision name="base_collision">
        <pose>-0.064 0 0.048 0 0 0</pose>
        <geometry><box><size>0.265 0.265 0.089</size></box></geometry>
      </collision>
      <visual name="base_visual">
        <pose>-0.064 0 0 0 0 0</pose>
        <geometry><mesh><uri>model://turtlebot3_common/meshes/bases/waffle_base.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
      </visual>
      <collision name="caster_back_right">
        <pose>-0.177 -0.064 -0.004 0 0 0</pose>
        <geometry><sphere><radius>0.006</radius></sphere></geometry>
        <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
      </collision>
      <collision name="caster_back_left">
        <pose>-0.177 0.064 -0.004 0 0 0</pose>
        <geometry><sphere><radius>0.006</radius></sphere></geometry>
        <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
      </collision>
      <visual name="lidar_visual">
        <pose>-0.064 0 0.121 0 0 0</pose>
        <geometry><mesh><uri>model://turtlebot3_common/meshes/sensors/lds.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
      <!-- Camera mount: the lens is at (-0.064, 0, 0.210) in base_link = 0.22 m above the floor -->
      <visual name="camera_mount_plate_visual">
        <pose>-0.0845 0 0.132 0 0 0</pose>
        <geometry><cylinder><radius>0.014</radius><length>0.004</length></cylinder></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
      <visual name="camera_post_visual">
        <pose>-0.0845 0 0.165 0 0 0</pose>
        <geometry><cylinder><radius>0.006</radius><length>0.066</length></cylinder></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
      <!-- camera body: 15 mm deep, 90 mm wide, 25 mm tall; front face at x=-0.072 -->
      <visual name="camera_visual">
        <pose>-0.0795 0 0.210 0 0 0</pose>
        <geometry><box><size>0.015 0.090 0.025</size></box></geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse>
          <specular>0.4 0.4 0.4 1</specular></material>
      </visual>
      <!-- lens barrel (axis along x), front face at x=-0.068 -->
      <visual name="camera_lens_barrel_visual">
        <pose>-0.0700 0 0.210 0 1.5708 0</pose>
        <geometry><cylinder><radius>0.010</radius><length>0.004</length></cylinder></geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
      </visual>

      <!-- Camera: 960x540: 62 deg horizontal FOV. -->
      <sensor name="camera" type="camera">
        <pose>-0.064 0 0.210 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <topic>camera/image_raw</topic>
        <camera>
          <horizontal_fov>1.085595</horizontal_fov>
          <image><width>960</width><height>540</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>20</far></clip>
        </camera>
      </sensor>

      <!-- LDS-01 style 2D lidar on /scan  -->
      <sensor name="lidar" type="gpu_lidar">
        <pose>-0.064 0 0.111 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <topic>scan</topic>
        <ignition_frame_id>base_scan</ignition_frame_id>
        <lidar>
          <scan>
            <horizontal><samples>720</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>6.28</max_angle></horizontal>
          </scan>
          <range><min>0.16</min><max>8.0</max><resolution>0.015</resolution></range>
        </lidar>
      </sensor>
    </link>

    <link name="left_wheel">
      <pose>0 0.1435 0.033 -1.5707 0 0</pose>
      <inertial>
        <mass>0.028498940</mass>
        <inertia><ixx>1.1175580e-05</ixx><iyy>1.1192413e-05</iyy><izz>2.0712558e-05</izz></inertia>
      </inertial>
      <collision name="c">
        <geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry>
        <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
      </collision>
      <visual name="v">
        <pose>0 0 0 1.5707 0 0</pose>
        <geometry><mesh><uri>model://turtlebot3_common/meshes/wheels/right_tire.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
    </link>
    <link name="right_wheel">
      <pose>0 -0.1435 0.033 -1.5707 0 0</pose>
      <inertial>
        <mass>0.028498940</mass>
        <inertia><ixx>1.1175580e-05</ixx><iyy>1.1192413e-05</iyy><izz>2.0712558e-05</izz></inertia>
      </inertial>
      <collision name="c">
        <geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry>
        <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
      </collision>
      <visual name="v">
        <pose>0 0 0 1.5707 0 0</pose>
        <geometry><mesh><uri>model://turtlebot3_common/meshes/wheels/left_tire.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
    </link>

    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent><child>left_wheel</child>
      <axis><xyz expressed_in="__model__">0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent><child>right_wheel</child>
      <axis><xyz expressed_in="__model__">0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.287</wheel_separation>
      <wheel_radius>0.033</wheel_radius>
      <max_linear_velocity>0.26</max_linear_velocity>
      <max_angular_velocity>1.82</max_angular_velocity>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <topic>/cmd_vel_safe</topic>   <!-- fed by safety_zones, which gates /cmd_vel -->
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
  </model>
</sdf>
