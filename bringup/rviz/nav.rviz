Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: nav2_rviz_plugins/Navigation 2
    Name: Navigation 2
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: false
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Alpha: 1
      Visual Enabled: true
      Description Source: Topic
      Description Topic: {Value: /robot_description, Depth: 1, Durability Policy: Transient Local, Reliability Policy: Reliable}
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic: {Value: /map, Depth: 1, Durability Policy: Transient Local, Reliability Policy: Reliable}
    - Class: rviz_default_plugins/Map
      Name: Global Costmap
      Enabled: true
      Alpha: 0.5
      Color Scheme: costmap
      Topic: {Value: /global_costmap/costmap, Depth: 1, Durability Policy: Transient Local, Reliability Policy: Reliable}
    - Class: rviz_default_plugins/Map
      Name: Local Costmap
      Enabled: true
      Alpha: 0.6
      Color Scheme: costmap
      Topic: {Value: /local_costmap/costmap, Depth: 1, Durability Policy: Transient Local, Reliability Policy: Reliable}
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Size (m): 0.05
      Color: 255; 0; 0
      Topic: {Value: /scan, Depth: 5, Reliability Policy: Best Effort}
    - Class: rviz_default_plugins/Path
      Name: Global Plan
      Enabled: true
      Color: 0; 200; 0
      Topic: {Value: /plan, Depth: 5, Reliability Policy: Reliable}
    - Class: rviz_default_plugins/Path
      Name: Local Plan
      Enabled: true
      Color: 0; 120; 255
      Topic: {Value: /local_plan, Depth: 5, Reliability Policy: Reliable}
    - Class: rviz_default_plugins/Polygon
      Name: Footprint
      Enabled: true
      Topic: {Value: /local_costmap/published_footprint, Reliability Policy: Reliable}
    - Class: rviz_default_plugins/MarkerArray
      Name: Human Markers
      Enabled: true
      Topic: {Value: /human_markers}
    - Class: rviz_default_plugins/MarkerArray
      Name: Intent Markers
      Enabled: true
      Topic: {Value: /intent_markers}
    - Class: rviz_default_plugins/MarkerArray
      Name: Safety Zones (yellow/red)
      Enabled: true
      Topic: {Value: /safety_zones}
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
      Topic: {Value: /initialpose}
    - Class: nav2_rviz_plugins/GoalTool
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 45
      X: 6
      Y: 0
